{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/scripts/**/*",
			"*.ts",
			"*.js",
			"*.mjs",
			"**/.vscode/**/*",
			"!**/.cache",
			"!**/.next",
			"!**/next-env.d.ts",
			"!**/src/app/\\[locale\\]",
			"!**/src/styles.css",
			"!**/src/locales/*.json",
			"!**/src/locales/*.js"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
