{
  "name": "laziness-next-start",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "bun run i18n:extract && next build",
    "start": "next start",
    "routes": "bun scripts/locale-routes.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format",
    "lint": "biome lint",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui extract --clean && lingui compile --strict",
    "verify": "bun run typecheck && bun run check && bun run i18n:check && bun run build"
  },
  "dependencies": {
    "@lingui/core": "^6.10.0",
    "@lingui/format-json": "^6.10.0",
    "@lingui/message-utils": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@lingui/cli": "^6.10.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp"
  ]
}
